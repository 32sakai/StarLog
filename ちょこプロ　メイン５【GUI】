# =========================
# 曜日ごとのデータ保存
# =========================
schedule = {
    "月曜日": [],
    "火曜日": [],
    "水曜日": [],
    "木曜日": [],
    "金曜日": []
}

# =========================
# 保存機能
# =========================
def save_data():
    with open(FILE_NAME, "w", encoding="utf-8") as file:
        json.dump(schedule, file, ensure_ascii=False, indent=4)

def load_data():
    global schedule

    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r", encoding="utf-8") as file:
            schedule = json.load(file)

# =========================
# 今日の曜日を取得
# =========================
def get_today_day():
    days = [
        "月曜日",
        "火曜日",
        "水曜日",
        "木曜日",
        "金曜日",
        "土曜日",
        "日曜日"
    ]

    today = datetime.date.today()
    return days[today.weekday()]

# =========================
# 一覧更新
# =========================
def update_list():
    listbox.delete(0, tk.END)

    day = day_var.get()

    if day == "":
        return

    for data in schedule[day]:
        item_text = "、".join(data["items"])

        listbox.insert(
            tk.END,
            f"{data['period']}時間目："
            f"{data['subject']} / 持ち物：{item_text}"
        )

# =========================
# 授業追加（6時間 / 水曜5時間）
# =========================
def add_subject():
    day = day_var.get()
    subject = subject_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    if subject == "":
        messagebox.showwarning("注意", "教科を選んでください")
        return

    if day == "水曜日":
        max_period = 5
    else:
        max_period = 6

    if len(schedule[day]) >= max_period:
        messagebox.showwarning(
            "注意",
            f"{day} は {max_period}時間までです"
        )
        return

    period = len(schedule[day]) + 1

    schedule[day].append({
        "period": period,
        "subject": subject,
        "items": subjects[subject]["item"].copy()
    })

    save_data()
    update_list()

    messagebox.showinfo(
        "追加完了",
        f"{day} の {period}時間目に\n"
        f"{subject} を追加しました！"
    )

# =========================
# 持ち物追加
# =========================
def add_item():
    day = day_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    selected = listbox.curselection()

    if not selected:
        messagebox.showwarning("注意", "授業を選んでください")
        return

    new_item = item_entry.get()

    if new_item == "":
        messagebox.showwarning("注意", "持ち物を入力してください")
        return

    index = selected[0]
    schedule[day][index]["items"].append(new_item)

    item_entry.delete(0, tk.END)

    save_data()
    update_list()

    messagebox.showinfo(
        "追加完了",
        f"{new_item} を追加しました！"
    )

# =========================
# 詳細表示（Wikipedia風）
# =========================
def show_detail():
    day = day_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    selected = listbox.curselection()

    if not selected:
        messagebox.showwarning("注意", "授業を選んでください")
        return

    index = selected[0]
    selected_data = schedule[day][index]
    subject = selected_data["subject"]

    base_data = subjects[subject]

    detail_window = tk.Toplevel(root)
    detail_window.title(f"{subject} の詳細")
    detail_window.geometry("450x400")

    tk.Label(
        detail_window,
        text=f"【{subject}】",
        font=("Arial", 16, "bold")
    ).pack(pady=10)

    tk.Label(
        detail_window,
        text=f"持ち物：{'、'.join(selected_data['items'])}",
        font=("Arial", 12)
    ).pack(pady=5)

    tk.Label(
        detail_window,
        text=f"教室：{base_data['room']}",
        font=("Arial", 12)
    ).pack(pady=5)

    tk.Label(
        detail_window,
        text=f"宿題：{base_data['homework']}",
        font=("Arial", 12)
    ).pack(pady=5)

    tk.Label(
        detail_window,
        text=f"テスト予定：{base_data['test']}",
        font=("Arial", 12)
    ).pack(pady=5)

    tk.Label(
        detail_window,
        text=f"提出物：{base_data['submission']}",
        font=("Arial", 12)
    ).pack(pady=5)

# =========================
# 削除
# =========================
def delete_subject():
    day = day_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    selected = listbox.curselection()

    if not selected:
        messagebox.showwarning("注意", "削除する授業を選んでください")
        return

    index = selected[0]
    removed = schedule[day].pop(index)

    for i, data in enumerate(schedule[day], start=1):
        data["period"] = i

    save_data()
    update_list()

    messagebox.showinfo(
        "削除完了",
        f"{removed['subject']} を削除しました！"
    )

