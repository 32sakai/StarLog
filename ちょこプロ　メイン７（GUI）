# =========================
def add_item():
    day = day_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    selected = listbox.curselection()

    if not selected:
        messagebox.showwarning("注意", "授業を選んでください")
        return

    new_item = item_entry.get()

    if new_item == "":
        messagebox.showwarning("注意", "持ち物を入力してください")
        return

    index = selected[0]
    schedule[day][index]["items"].append(new_item)

    item_entry.delete(0, tk.END)

    save_data()
    update_list()

    messagebox.showinfo(
        "追加完了",
        f"{new_item} を追加しました！"
    )

