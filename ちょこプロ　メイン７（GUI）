# =========================
# 詳細を編集
# =========================
def edit_detail():
    day = day_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    selected = listbox.curselection()

    if not selected:
        messagebox.showwarning("注意", "授業を選んでください")
        return

    index = selected[0]
    selected_data = schedule[day][index]
    subject = selected_data["subject"]

    data = subjects[subject]

    edit_window = tk.Toplevel(root)
    edit_window.title(f"{subject} の詳細編集")
    edit_window.geometry("400x450")

    tk.Label(edit_window, text="教室").pack()
    room_entry = tk.Entry(edit_window, width=30)
    room_entry.pack()
    room_entry.insert(0, data["room"])

    tk.Label(edit_window, text="宿題").pack()
    homework_entry = tk.Entry(edit_window, width=30)
    homework_entry.pack()
    homework_entry.insert(0, data["homework"])

    tk.Label(edit_window, text="テスト予定").pack()
    test_entry = tk.Entry(edit_window, width=30)
    test_entry.pack()
    test_entry.insert(0, data["test"])

    tk.Label(edit_window, text="提出物").pack()
    submission_entry = tk.Entry(edit_window, width=30)
    submission_entry.pack()
    submission_entry.insert(0, data["submission"])

    def save_detail():
        data["room"] = room_entry.get()
        data["homework"] = homework_entry.get()
        data["test"] = test_entry.get()
        data["submission"] = submission_entry.get()

        save_data()

        messagebox.showinfo(
            "保存完了",
            f"{subject} の詳細を更新しました！"
        )

        edit_window.destroy()

    save_button = tk.Button(
        edit_window,
        text="保存する",
        command=save_detail,
        font=("Arial", 12),
        width=15
    )
    save_button.pack(pady=20)

# =========================
# 削除
# =========================
def delete_subject():
    day = day_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    selected = listbox.curselection()

    if not selected:
        messagebox.showwarning("注意", "削除する授業を選んでください")
        return

    index = selected[0]
    removed = schedule[day].pop(index)

    for i, data in enumerate(schedule[day], start=1):
        data["period"] = i

    save_data()
    update_list()

    messagebox.showinfo(
        "削除完了",
        f"{removed['subject']} を削除しました！"
    )

