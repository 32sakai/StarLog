# =========================
# 曜日ごとの保存
# =========================
schedule = {
    "月曜日": [],
    "火曜日": [],
    "水曜日": [],
    "木曜日": [],
    "金曜日": []
}

# =========================
# 保存機能
# =========================
def save_data():
    with open(FILE_NAME, "w", encoding="utf-8") as file:
        json.dump(schedule, file, ensure_ascii=False, indent=4)

def load_data():
    global schedule

    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r", encoding="utf-8") as file:
            schedule = json.load(file)

# =========================
# 今日の曜日を取得
# =========================
def get_today_day():
    days = [
        "月曜日",
        "火曜日",
        "水曜日",
        "木曜日",
        "金曜日",
        "土曜日",
        "日曜日"
    ]

    today = datetime.date.today()
    return days[today.weekday()]

# =========================
# 一覧更新
# =========================
def update_list():
    listbox.delete(0, tk.END)

    day = day_var.get()

    if day == "":
        return

    for data in schedule[day]:
        item_text = "、".join(data["items"])

        listbox.insert(
            tk.END,
            f"{data['period']}時間目："
            f"{data['subject']} / 持ち物：{item_text}"
        )

# =========================
# 授業追加
# =========================
def add_subject():
    day = day_var.get()
    subject = subject_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    if subject == "":
        messagebox.showwarning("注意", "教科を選んでください")
        return

    if day == "水曜日":
        max_period = 5
    else:
        max_period = 6

    if len(schedule[day]) >= max_period:
        messagebox.showwarning(
            "注意",
            f"{day} は {max_period}時間までです"
        )
        return

    period = len(schedule[day]) + 1

    schedule[day].append({
        "period": period,
        "subject": subject,
        "items": subjects[subject]["item"].copy()
    })

    save_data()
    update_list()

    messagebox.showinfo(
        "追加完了",
        f"{day} の {period}時間目に\n"
        f"{subject} を追加しました！"
    )

