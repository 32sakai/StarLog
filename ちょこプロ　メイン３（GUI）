import json
import os

# ------------------------
# 保存ファイル名
# ------------------------
FILE_NAME = "schedule_gui.json"

# ------------------------
# 教科データ
# ------------------------
subjects = {
    "国語": "国語の教科書",
    "数学": "数学の教科書",
    "英語": "英語の教科書",
    "理科": "理科の教科書",
    "社会": "地理の教科書",
    "音楽": "音楽の教科書",
    "美術": "美術の教科書",
    "保健体育": "保健体育の教科書",
    "技術・家庭": "技術・家庭の教科書"
}

# ------------------------
# 曜日ごとの保存
# ------------------------
schedule = {
    "月曜日": [],
    "火曜日": [],
    "水曜日": [],
    "木曜日": [],
    "金曜日": []
}


# ------------------------
# 保存機能
# ------------------------
def save_data():
    with open(FILE_NAME, "w", encoding="utf-8") as file:
        json.dump(schedule, file, ensure_ascii=False, indent=4)


def load_data():
    global schedule

    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r", encoding="utf-8") as file:
            schedule = json.load(file)


# ------------------------
# 一覧更新
# ------------------------
def update_list():
    listbox.delete(0, tk.END)

    day = day_var.get()

    if day == "":
        return

    for data in schedule[day]:
        items_text = "、".join(data["items"])

        listbox.insert(
            tk.END,
            f"{data['period']}時間目："
            f"{data['subject']} / 持ち物：{items_text}"
        )


# ------------------------
# 授業追加（6時間 or 水曜5時間）
# ------------------------
def add_subject():
    day = day_var.get()
    subject = subject_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    if subject == "":
        messagebox.showwarning("注意", "教科を選んでください")
        return

    # 水曜日は5時間まで
    if day == "水曜日":
        max_period = 5
    else:
        max_period = 6

    if len(schedule[day]) >= max_period:
        messagebox.showwarning(
            "注意",
            f"{day} は {max_period}時間までです"
        )
        return

    period = len(schedule[day]) + 1

    schedule[day].append({
        "period": period,
        "subject": subject,
        "items": [subjects[subject]]
    })

    save_data()
    update_list()

    messagebox.showinfo(
        "追加完了",
        f"{day} の {period}時間目に\n"
        f"{subject} を追加しました！"
    )


# ------------------------
# 持ち物追加
# ------------------------
def add_item():
    day = day_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    selected = listbox.curselection()

    if not selected:
        messagebox.showwarning("注意", "時間割を選んでください")
        return

    new_item = item_entry.get()

    if new_item == "":
        messagebox.showwarning("注意", "追加する持ち物を入力してください")
        return

    index = selected[0]
    schedule[day][index]["items"].append(new_item)

    item_entry.delete(0, tk.END)

    save_data()
    update_list()

    messagebox.showinfo(
        "追加完了",
        f"{new_item} を追加しました！"
    )


# ------------------------
# 授業削除
# ------------------------
def delete_subject():
    day = day_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    selected = listbox.curselection()

    if not selected:
        messagebox.showwarning("注意", "削除する項目を選んでください")
        return

    index = selected[0]
    removed = schedule[day].pop(index)

    # 時間目を振り直す
    for i, data in enumerate(schedule[day], start=1):
        data["period"] = i

    save_data()
    update_list()

    messagebox.showinfo(
        "削除完了",
        f"{removed['subject']} を削除しました！"
    )


# ------------------------
# 全削除
# ------------------------
def clear_day():
    day = day_var.get()

    if day == "":
        messagebox.showwarning("注意", "曜日を選んでください")
        return

    schedule[day] = []

    save_data()
    update_list()

    messagebox.showinfo(
        "削除完了",
        f"{day} の予定をすべて削除しました！"
    )


