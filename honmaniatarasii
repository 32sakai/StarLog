import tkinter as tk
import json
import os

# -----------------
# 初期データ
# -----------------

schedule = {
    "月曜日": [
        {
            "subject": "数学",
            "room": "2年2組",
            "homework": "問題集P12"
        },
        {
            "subject": "英語",
            "room": "2年3組",
            "homework": "英単語20個"
        },
        {
            "subject": "理科",
            "room": "理科室",
            "homework": "レポート作成"
        }
    ]
}

SAVE_FILE = "schedule.json"

# -----------------
# 保存
# -----------------

def save_data():

    with open(
        SAVE_FILE,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            schedule,
            f,
            ensure_ascii=False,
            indent=4
        )

# -----------------
# 読み込み
# -----------------

def load_data():

    global schedule

    if os.path.exists(SAVE_FILE):

        with open(
            SAVE_FILE,
            "r",
            encoding="utf-8"
        ) as f:

            schedule = json.load(f)

# -----------------
# 戻る
# -----------------

def back_to_main():

    detail_frame.pack_forget()

    main_frame.pack(
        fill="both",
        expand=True
    )

# -----------------
# 詳細画面
# -----------------

def show_detail(data):

    main_frame.pack_forget()

    for widget in detail_frame.winfo_children():
        widget.destroy()

    detail_frame.pack(
        fill="both",
        expand=True
    )

    # 戻るボタン
    back_button = tk.Button(
        detail_frame,
        text="← 戻る",
        font=("Arial", 14),
        command=back_to_main
    )

    back_button.pack(pady=10)

    # 教科名
    title = tk.Label(
        detail_frame,
        text=data["subject"],
        font=("Arial", 24, "bold")
    )

    title.pack(pady=20)

    # 教室
    room_label = tk.Label(
        detail_frame,
        text=f"教室: {data['room']}",
        font=("Arial", 16)
    )

    room_label.pack(pady=10)

    # 宿題
    homework_label = tk.Label(
        detail_frame,
        text=f"宿題: {data['homework']}",
        font=("Arial", 16)
    )

    homework_label.pack(pady=10)

    # 編集エリア
    edit_frame = tk.Frame(detail_frame)

    tk.Label(
        edit_frame,
        text="教室"
    ).pack()

    room_entry = tk.Entry(
        edit_frame,
        width=30
    )

    room_entry.pack(pady=5)

    tk.Label(
        edit_frame,
        text="宿題"
    ).pack()

    homework_entry = tk.Entry(
        edit_frame,
        width=30
    )

    homework_entry.pack(pady=5)

    # 完了ボタン処理
    def finish_edit():

        data["room"] = room_entry.get()
        data["homework"] = homework_entry.get()

        room_label.config(
            text=f"教室: {data['room']}"
        )

        homework_label.config(
            text=f"宿題: {data['homework']}"
        )

        save_data()

        edit_frame.pack_forget()

    finish_button = tk.Button(
        edit_frame,
        text="完了",
        command=finish_edit
    )

    finish_button.pack(pady=10)

    # 編集開始
    def start_edit():

        room_entry.delete(0, tk.END)
        room_entry.insert(0, data["room"])

        homework_entry.delete(0, tk.END)
        homework_entry.insert(0, data["homework"])

        edit_frame.pack(pady=20)

    edit_button = tk.Button(
        detail_frame,
        text="編集",
        font=("Arial", 14),
        command=start_edit
    )

    edit_button.pack(pady=15)

# -----------------
# 時間割表示
# -----------------

def load_day():

    for widget in lesson_frame.winfo_children():
        widget.destroy()

    day = day_var.get()

    lessons = schedule[day]

    for i, lesson in enumerate(lessons):

        btn = tk.Button(
            lesson_frame,
            text=f"{i+1}時間目\n{lesson['subject']}",
            font=("Arial", 18),
            height=4,
            command=lambda d=lesson:
                show_detail(d)
        )

        btn.pack(
            fill="x",
            padx=15,
            pady=10
        )

# -----------------
# 起動時に保存データ読込
# -----------------

load_data()

# -----------------
# メイン画面
# -----------------

root = tk.Tk()

root.title("学校アプリ")
root.geometry("430x850")

main_frame = tk.Frame(root)

main_frame.pack(
    fill="both",
    expand=True
)

detail_frame = tk.Frame(root)

title = tk.Label(
    main_frame,
    text="時間割",
    font=("Arial", 22, "bold")
)

title.pack(pady=20)

day_var = tk.StringVar(
    value="月曜日"
)

day_menu = tk.OptionMenu(
    main_frame,
    day_var,
    "月曜日",
    command=lambda x: load_day()
)

day_menu.pack(pady=10)

lesson_frame = tk.Frame(main_frame)

lesson_frame.pack(
    fill="both",
    expand=True
)

load_day()

root.mainloop()